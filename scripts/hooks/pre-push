#!/usr/bin/env bash
# levain pre-push gate — the release-stamp check, at the boundary that matters.
#
# ⛔ WHY THIS EXISTS, and it is a measured failure rather than a precaution.
# 2026-09-03: this repo gained both the POLICY ("the release commit is the last
# one on that number") and the TEST that enforces it. An hour later the anneal
# seat committed the identical defect one commit past its own v0.9.9 tag — and
# the flow action-boundary hook printed the governing note IN FULL, correct and
# specific, immediately before that push. It happened anyway. Reading is not
# acting.
#
# The test already existed on both sides by then. What did not exist was
# anything that RUNS it between "the stamp is wrong" and "it is public". CI
# fires after the push, which is after the damage; the recall hook is advisory
# and had just failed its one job on this exact defect. This closes that window.
#
# ⛔ DELIBERATELY FAILS CLOSED. A guard that degrades to a pass when it cannot
# run is the precise shape of the defect it guards — an instrument reporting
# health because it could not look. The escape is explicit and visible:
#     git push --no-verify
# Ported from anneal-memory's scripts/hooks/pre-push (0903+7 anneal-seat), which
# was verified against the real defect rather than a simulation.
set -uo pipefail

root="$(git rev-parse --show-toplevel)"
cd "$root" || exit 1

PY=""
for cand in .venv/bin/python python3; do
    if command -v "$cand" >/dev/null 2>&1 || [ -x "$cand" ]; then PY="$cand"; break; fi
done

if [ -z "$PY" ]; then
    echo "pre-push: no python found to run the release-stamp gate." >&2
    echo "          Fix the environment, or push deliberately with --no-verify." >&2
    exit 1
fi

# THE SUBJECT IS WHAT IS PUSHED, NOT THIS CHECKOUT'S HEAD (2026-10-11,
# reproduced): reading HEAD refused correct pushes made from a checkout parked
# on an older branch, every branch delete, and the release tag itself. git
# writes one "<local ref> <local sha> <remote ref> <remote sha>" line per ref on
# stdin; an all-zero local sha is a delete, which publishes nothing.
zero="0000000000000000000000000000000000000000"
shas=""
while read -r _lref lsha _rref _rsha; do
    [ -z "${lsha:-}" ] && continue
    [ "$lsha" = "$zero" ] && continue
    if ! c="$(git rev-parse --verify -q "${lsha}^{commit}")"; then
        echo "pre-push: pushed object $lsha is not a commit; the release-stamp gate cannot read it." >&2
        echo "          Push deliberately with --no-verify if this is intended." >&2
        exit 1
    fi
    shas="$shas $c"
done
[ -z "$shas" ] && exit 0   # deletes only

out="$(mktemp)"
if ! LEVAIN_PUSHED_SHAS="$shas" "$PY" -m pytest tests/test_manifest.py -q -p no:cacheprovider \
        -k "ReleaseStampIsNotAPublishedVersion and committed" >"$out" 2>&1; then
    echo >&2
    echo "⛔ pre-push BLOCKED — the release-stamp gate failed:" >&2
    echo >&2
    sed -n '/FAILED\|AssertionError\|Error/p' "$out" | head -8 >&2
    echo >&2
    echo "   A pushed commit is stamped at an already-released version, or its two" >&2
    echo "   stamps disagree. Bump BOTH (pyproject.toml, levain/__init__.py) to the next" >&2
    echo "   .devN — or, if this IS the release commit, make the stamp bump and" >&2
    echo "   the tag the SAME commit. See spore-710 and CHANGELOG 'Versioning'." >&2
    echo >&2
    echo "   To push anyway: git push --no-verify" >&2
    rm -f "$out"
    exit 1
fi
rm -f "$out"
exit 0
